# Copy to .env (gitignored) or set these in your shell / Render dashboard.
# Placeholders only - never commit real values.

# --- Database (required in prod) -------------------------------------------
# Supabase: Project settings > Database > Connection pooling (session mode), JDBC form.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
# Optional: Hikari pool size for the free pooler (default 5).
DB_POOL_SIZE=5

# --- Security (required in prod) -------------------------------------------
# At least 32 random characters. Example to generate one (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=<at-least-32-random-characters>

# --- Encryption at rest (required) -----------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=<openssl-rand-base64-32>
DATA_ENCRYPTION_KEY_ID=k1
BLIND_INDEX_KEY=<openssl-rand-base64-32>
# Token lifetime as ISO-8601 duration (default 8 hours).
JWT_TTL=PT8H
# Exact frontend origins, comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-frontend>.vercel.app

# --- AI provider ------------------------------------------------------------
# ollama (local dev) | ollama-cloud (Gemma 4 on Ollama Cloud) | groq (prod, free API) | stub (offline demo, no AI calls)
LLM_PROVIDER=stub
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Ollama Cloud only (blank for the local daemon). Pair with:
#   LLM_PROVIDER=ollama-cloud
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=<ollama-cloud-api-key>
VOYAGE_API_KEY=<voyage-api-key>

# --- Optional ---------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=true
PIPELINE_DEFAULT_HOURS=8
PIPELINE_HOURS_PER_WEEK=40
PRICING_FIXED_RISK_BUFFER=0.20
PRICING_PHASED_OVERHEAD=0.10

# Spec 11: Gmail intake (docs/specs/11-gmail-ingest.md has the Google Cloud setup)
GMAIL_ENABLED=false
GMAIL_MAILBOX=cotiza@example.com
GMAIL_LABEL=cotizar
GMAIL_AGENCY_ID=<agency id that owns the mailbox>
GMAIL_CLIENT_ID=<oauth client id>
GMAIL_CLIENT_SECRET=<oauth client secret>
GMAIL_REFRESH_TOKEN=<refresh token with gmail.readonly>
# Poll mode: PT1M. Push mode: GMAIL_PUSH_ENABLED=true and a slower safety poll, e.g. PT15M.
GMAIL_POLL_INTERVAL=PT1M
GMAIL_PUSH_ENABLED=false
GMAIL_PUSH_TOPIC=projects/<project>/topics/gmail-cotiza
GMAIL_PUSH_AUDIENCE=https://<backend-host>/api/ingest/email
GMAIL_PUSH_SERVICE_ACCOUNT=gmail-push@<project>.iam.gserviceaccount.com

# Spec 16: email (verification + document delivery). OFF by default: with MAIL_ENABLED=false the app
# wires the no-op adapter, opens no SMTP connection and logs only "email skipped: <subject>".
# Point these at any SMTP relay (Brevo, Resend, SendGrid...). Secrets never live in git.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_FROM=no-reply@example.com
# STARTTLS on port 587; set false only for a local relay such as MailHog/GreenMail.
MAIL_STARTTLS=true
# Link base of the verification mail: the frontend origin that serves /verify-email.
APP_PUBLIC_URL=http://localhost:5173
# true = a new account must confirm its mailbox before login (403 "Email not verified" until then).
MAIL_VERIFICATION_REQUIRED=false
# true = sent documents are also mailed to the client's address on file.
MAIL_SEND_TO_CLIENT=false

# Spec 12: LLM failover. Gemma 4 on Google AI Studio first, Groq second; one key per provider and per project.
LLM_CHAIN=
GEMINI_API_KEY=<google ai studio key>
GEMINI_MODEL=gemma-4-31b-it

# WhatsApp notices: shared secret of the WhatsApp service (whatsapp-service/), 32+ characters. Empty = off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WHATSAPP_SERVICE_KEY=
# WhatsApp bot: agency whose catalog and rates it quotes from, and the link it sends. Empty agency = bot quiet.
WHATSAPP_AGENCY_ID=
WHATSAPP_SITE_URL=https://cotizaia.example.com
