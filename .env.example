# Copy to .env (gitignored) or set these in your shell / Render dashboard.
# Placeholders only - never commit real values.

# --- Database (required in prod) -------------------------------------------
# Supabase: Project settings > Database > Connection pooling (session mode), JDBC form.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
# Optional: Hikari pool size for the free pooler (default 5).
DB_POOL_SIZE=5

# --- Security (required in prod) -------------------------------------------
# At least 32 random characters. Example to generate one (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=<at-least-32-random-characters>

# --- Encryption at rest (required) -----------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=<openssl-rand-base64-32>
DATA_ENCRYPTION_KEY_ID=k1
BLIND_INDEX_KEY=<openssl-rand-base64-32>
# Token lifetime as ISO-8601 duration (default 8 hours).
JWT_TTL=PT8H
# Exact frontend origins, comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://<your-frontend>.vercel.app

# --- AI provider ------------------------------------------------------------
# ollama (local dev) | ollama-cloud (Gemma 4 on Ollama Cloud) | groq (prod, free API) | stub (offline demo, no AI calls)
LLM_PROVIDER=stub
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
# Ollama Cloud only (blank for the local daemon). Pair with:
#   LLM_PROVIDER=ollama-cloud
#   OLLAMA_BASE_URL=https://ollama.com
#   OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=<ollama-cloud-api-key>
VOYAGE_API_KEY=<voyage-api-key>

# --- Optional ---------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=true
PIPELINE_DEFAULT_HOURS=8
PIPELINE_HOURS_PER_WEEK=40
PRICING_FIXED_RISK_BUFFER=0.20
PRICING_PHASED_OVERHEAD=0.10
