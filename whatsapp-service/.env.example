# Copia este archivo como .env y completa los valores. El .env nunca se sube a git.
# Backend de CotizaIA: local (http://localhost:8080) o el de Render.
BACKEND_URL=http://localhost:8080
# El mismo valor de WHATSAPP_SERVICE_KEY que tiene el backend (32+ caracteres). Nunca lo pongas en el frontend.
WHATSAPP_SERVICE_KEY=
